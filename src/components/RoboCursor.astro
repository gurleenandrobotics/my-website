---
// RoboCursor component – client‑only, persists across Astro page transitions
---
<div id="robo-hand" aria-hidden="true" data-state="open" class="pointer-events-none fixed top-0 left-0 w-12 h-12 z-50"></div>

<script client:load>
  // Bail out on non‑fine pointer devices
  if (!window.matchMedia('(pointer: fine) and (hover: hover)').matches) {
    // Ensure native cursor stays visible
    document.documentElement.classList.remove('robo-cursor-on');
    return;
  }

  const htmlEl = document.documentElement;
  const hand = document.getElementById('robo-hand');
  if (!hand) return;

  // Default to enabled; persist via localStorage
  const storageKey = 'roboCursorEnabled';
  let enabled = localStorage.getItem(storageKey);
  if (enabled === null) {
    enabled = 'true';
    localStorage.setItem(storageKey, enabled);
  }
  const isEnabled = enabled === 'true';
  if (isEnabled) htmlEl.classList.add('robo-cursor-on');
  else htmlEl.classList.remove('robo-cursor-on');

  if (!isEnabled) return;

  // Simple hand SVG – groups for fingers (placeholder shapes)
  hand.innerHTML = `
    <svg viewBox="0 0 100 100" width="100%" height="100%" preserveAspectRatio="xMidYMid meet">
      <g id="palm" fill="#555"><circle cx="50" cy="60" r="30"/></g>
      <g id="thumb" fill="#555"><rect x="35" y="30" width="10" height="20"/></g>
      <g id="index" fill="#555"><rect x="45" y="20" width="10" height="30"/></g>
      <g id="middle" fill="#555"><rect x="55" y="20" width="10" height="30"/></g>
      <g id="ring" fill="#555"><rect x="65" y="30" width="10" height="20"/></g>
      <g id="pinky" fill="#555"><rect x="75" y="40" width="8" height="10"/></g>
    </svg>
  `;

  // Position tracking
  let targetX = 0, targetY = 0;
  let posX = 0, posY = 0;
  const lerp = 0.2;
  const offset = { x: 0, y: -20 }; // fingertip offset (adjust as needed)

  function onMove(e) {
    targetX = e.clientX + offset.x;
    targetY = e.clientY + offset.y;
    idleTimer = 0; // reset idle
    setState('open');
  }

  function setState(state) {
    hand.dataset.state = state;
  }

  // Hover / click handling
  document.addEventListener('pointerover', (e) => {
    const el = e.target;
    if (el.matches('a, button, [role="button"], .project-card')) {
      setState('point');
    }
  });
  document.addEventListener('pointerout', (e) => {
    const el = e.target;
    if (el.matches('a, button, [role="button"], .project-card')) {
      setState('open');
    }
  });
  document.addEventListener('pointerdown', () => setState('fist'));
  document.addEventListener('pointerup', () => setState('open'));

  // Hide over form controls
  document.addEventListener('focusin', (e) => {
    if (e.target.matches('input, textarea, select, [contenteditable]')) {
      hand.style.display = 'none';
    }
  });
  document.addEventListener('focusout', (e) => {
    if (e.target.matches('input, textarea, select, [contenteditable]')) {
      hand.style.display = '';
    }
  });

  // Idle wave after 6 s
  let idleTimer = 0;
  const idleThreshold = 6000; // ms
  setInterval(() => {
    idleTimer += 100;
    if (idleTimer >= idleThreshold) {
      setState('wave');
    }
  }, 100);

  // Animation loop
  function animate() {
    posX += (targetX - posX) * lerp;
    posY += (targetY - posY) * lerp;
    hand.style.transform = `translate3d(${posX}px, ${posY}px, 0)`;
    requestAnimationFrame(animate);
  }
  animate();

  // Respect prefers‑reduced‑motion – snap instantly and skip wave
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduced) {
    // Override lerp for instant movement
    const originalLerp = lerp;
    // Note: we cannot reassign const, so we just bypass animation loop
    hand.style.transition = 'transform 0s';
  }
</script>

<style>
  html.robo-cursor-on { cursor: none; }
  #robo-hand[data-state="open"] #index { transform: rotate(0deg); }
  #robo-hand[data-state="point"] #index { transform: rotate(-30deg); }
  #robo-hand[data-state="fist"] #index, #robo-hand[data-state="fist"] #middle, #robo-hand[data-state="fist"] #ring, #robo-hand[data-state="fist"] #pinky, #robo-hand[data-state="fist"] #thumb { transform: rotate(20deg); }
  @keyframes waveAnim {
    0%, 100% { transform: rotate(0deg); }
    50% { transform: rotate(15deg); }
  }
  #robo-hand[data-state="wave"] #palm { animation: waveAnim 1s infinite ease-in-out; }
</style>
